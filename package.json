{
  "name": "kg-governance-dashboard",
  "version": "0.2.0",
  "private": true,
  "description": "Synthetic governance-event demo by default, with an optional approved audit-stream connection, local alerts, trend charts, and selected NIST AI RMF review topics.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run && node --test tests/check-demo-config.node.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "motion": "^12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
